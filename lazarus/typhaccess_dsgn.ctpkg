<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="typhaccess_dsgn"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="TyphAccess"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\src\gui"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)\$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="Komponente TyphAccess za paletu: TaSideMenu, TaDatabase, TaExpression, TaReport, TaProgram, TaFormBinder, uz carobnjak i property editore"/>
    <License Value="Vlastita biblioteka"/>
    <Version Major="0" Minor="1"/>
    <Files>
      <Item>
        <Filename Value="ta_register.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="ta_register"/>
      </Item>
      <Item>
        <Filename Value="..\src\gui\ta_components.pas"/>
        <UnitName Value="ta_components"/>
      </Item>
      <Item>
        <Filename Value="..\src\gui\ta_binder.pas"/>
        <UnitName Value="ta_binder"/>
      </Item>
      <Item>
        <Filename Value="ta_templates.pas"/>
        <UnitName Value="ta_templates"/>
      </Item>
      <Item>
        <Filename Value="..\src\gui\ta_contcomp.pas"/>
        <UnitName Value="ta_contcomp"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="adLCL"/>
      </Item>
      <Item>
        <PackageName Value="pl_ZeosDBO"/>
      </Item>
      <Item>
        <PackageName Value="pl_PascalScript"/>
      </Item>
      <Item>
        <PackageName Value="pl_FpSpreadsheet"/>
      </Item>
      <Item>
        <PackageName Value="pl_RichMemo"/>
      </Item>
      <Item>
        <PackageName Value="pl_Image32"/>
      </Item>
      <Item>
        <PackageName Value="typhaccess_core"/>
      </Item>
      <Item>
        <PackageName Value="typhaccess_editors"/>
      </Item>
      <Item>
        <PackageName Value="bs_ideintf"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
