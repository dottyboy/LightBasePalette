<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="typhaccess_ext"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="TyphAccess"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\src\ext"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)\$(LCLWidgetType)"/>
      </SearchPaths>
      <Parsing>
        <SyntaxOptions>
          <SyntaxMode Value="ObjFPC"/>
          <UseAnsiStrings Value="False"/>
        </SyntaxOptions>
      </Parsing>
    </CompilerOptions>
    <Description Value="TyphAccess neobavezni pokretaci: TAChart (Chart), TRxDBGrid (Grid)"/>
    <License Value="Vlastita biblioteka"/>
    <Version Major="0" Minor="1"/>
    <Files>
      <Item>
        <Filename Value="..\src\ext\ta_ext_chart.pas"/>
        <UnitName Value="ta_ext_chart"/>
      </Item>
      <Item>
        <Filename Value="..\src\ext\ta_ext_grid.pas"/>
        <UnitName Value="ta_ext_grid"/>
      </Item>
      <Item>
        <Filename Value="..\src\ext\ta_ext_select.pas"/>
        <UnitName Value="ta_ext_select"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="adLCL"/>
      </Item>
      <Item>
        <PackageName Value="pl_ZeosDBO"/>
      </Item>
      <Item>
        <PackageName Value="pl_PascalScript"/>
      </Item>
      <Item>
        <PackageName Value="pl_FpSpreadsheet"/>
      </Item>
      <Item>
        <PackageName Value="pl_RichMemo"/>
      </Item>
      <Item>
        <PackageName Value="pl_Image32"/>
      </Item>
      <Item>
        <PackageName Value="typhaccess_core"/>
      </Item>
      <Item>
        <PackageName Value="lz_taChart"/>
      </Item>
      <Item>
        <PackageName Value="pl_RX"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
