@format 1
@kostur  Izvoz tablice u PDF
@opis    Ispis svih redaka tablice kao izvješće u PDF datoteku.
@kontekst  gumb,izvjesce
@kategorija  Izvješća
@utor tablica   : tablica                                 "Koja tablica?"
@utor stupci    : stupci(tablica) zadano=sviOsimId         "Koji se stupci ispisuju?"
@utor datoteka  : tekst zadano="{tablica}.pdf"            "Naziv PDF datoteke"
@preduvjet tablica ima barem 2 stupca
---
REPORT popis(r)
  DEFINE r RECORD LIKE {tablica}.*
  OUTPUT PAGE LENGTH 60
  FORMAT
    PAGE HEADER
      PRINT "{tablica}", COLUMN 60, "Str. ", PAGENO
      SKIP 1 LINES
    ON EVERY ROW
      PRINT {stupci:ispis}
    ON LAST ROW
      SKIP 1 LINES
      PRINT "Ukupno redaka: ", COUNT(*)
END REPORT

MAIN
  DEFINE r RECORD LIKE {tablica}.*
  DECLARE c CURSOR FOR SELECT * FROM {tablica}
  START REPORT popis TO PDF "{datoteka}"
  FOREACH c INTO r.*
    OUTPUT TO REPORT popis(r.*)
  END FOREACH
  FINISH REPORT popis
  MESSAGE "Izvješće je spremljeno u {datoteka}"
END MAIN
