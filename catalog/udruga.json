     10,
     "2026-02-05",
     "Gotovina"
    ],
    [
     3,
     1,
     2025,
     20,
     "2025-01-18",
     "Uplatnica"
    ]
   ],
   "report": true,
   "report_group": "godina",
   "report_sort": "datum"
  },
  {
