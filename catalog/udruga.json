{
 "id": "udruga",
 "title": "Udruga: članovi i članarine",
 "descr": "Mala udruga ili klub: popis članova, članarine po godinama, sastanci i prisutnost.",
 "tags": "zajednica,udruga,clanstvo",
 "tables": [
  {
   "name": "clan_udruge",
   "caption": "Članovi",
   "descr": "Osobe koje su članovi udruge.",
   "fields": [
    {
     "name": "sifra",
     "caption": "Šifra",
     "type": "autonumber",
     "role": "kljuc",
     "descr": "Šifra člana.",
     "pk": true
    },
    {
     "name": "ime",
     "caption": "Ime",
     "type": "text",
     "role": "naziv",
     "descr": "Osobno ime.",
     "required": true
    },
    {
     "name": "prezime",
     "caption": "Prezime",
     "type": "text",
     "role": "naziv",
     "descr": "Prezime.",
     "required": true
    },
    {
     "name": "oib",
     "caption": "OIB",
     "type": "text",
     "role": "identifikator",
     "descr": "Osobni identifikacijski broj, 11 znamenki (kod tvrtke ili osobe).",
     "validation": "Len([value]) = 11 And IsNumeric([value])",
     "validation_msg": "OIB mora imati točno 11 znamenki."
    },
    {
     "name": "email",
     "caption": "E-pošta",
     "type": "text",
     "role": "kontakt",
     "descr": "Adresa elektroničke pošte; provjerava se oblik a@b.c.",
     "validation": "[value] Like \"*@*.*\"",
     "validation_msg": "Unesi ispravnu adresu e-pošte (npr. ime@tvrtka.hr).",
     "width": 200
    },
    {
     "name": "telefon",
     "caption": "Telefon",
     "type": "text",
     "role": "kontakt",
     "descr": "Broj telefona ili mobitela, slobodnog oblika."
    },
    {
     "name": "datum_uclanjenja",
     "caption": "Učlanjen",
     "type": "date",
     "role": "datum",
     "descr": "Kada je osoba postala član.",
     "default": "Date()"
    },
    {
     "name": "status_clanstva",
     "caption": "Status",
     "type": "text",
     "role": "kategorija",
     "descr": "Je li član aktivan; istupili članovi ostaju radi povijesti.",
     "choices": "Aktivan,Pasivan,Istupio",
     "default": "\"Aktivan\""
    },
    {
     "name": "vrsta_clana",
     "caption": "Vrsta člana",
     "type": "text",
     "role": "kategorija",
     "descr": "Vrsta članstva; može određivati iznos članarine.",
     "choices": "Redovni,Počasni,Mladi,Umirovljenik",
     "default": "\"Redovni\""
    }
   ],
   "sample": [
    [
     1,
     "Ana",
     "Kovač",
     "12345678903",
     "ana.kovac@mail.hr",
     "091 111 2233",
     "2022-01-15",
     "Aktivan",
     "Redovni"
    ],
    [
     2,
     "Marko",
     "Perić",
     "98765432109",
     "marko.peric@mail.hr",
     "098 333 4455",
     "2023-03-10",
     "Aktivan",
     "Mladi"
    ],
    [
     3,
     "Ivo",
     "Babić",
     "45678912305",
     null,
     "095 555 6677",
     "2019-09-01",
     "Pasivan",
     "Počasni"
    ]
   ]
  },
  {
   "name": "clanarina_udruge",
   "caption": "Članarine",
   "descr": "Uplaćene članarine po godinama.",
   "fields": [
    {
     "name": "sifra",
     "caption": "Šifra",
     "type": "autonumber",
     "role": "kljuc",
     "descr": "Šifra uplate.",
     "pk": true
    },
    {
     "name": "clan_id",
     "caption": "Član",
     "type": "integer",
     "role": "veza",
     "descr": "Član koji je platio.",
     "ref": "clan_udruge.sifra",
     "required": true,
     "on_delete": "cascade"
    },
    {
     "name": "godina",
     "caption": "Godina",
     "type": "integer",
     "role": "datum",
     "descr": "Godina na koju se podatak odnosi.",
     "required": true,
     "validation": "[value] >= 2000 And [value] <= 2100",
     "validation_msg": "Unesi godinu između 2000 i 2100."
    },
    {
     "name": "iznos",
     "caption": "Iznos",
     "type": "currency",
     "role": "iznos",
     "descr": "Uplaćeni iznos članarine.",
     "decimals": 2
    },
    {
     "name": "datum",
     "caption": "Datum",
     "type": "date",
     "role": "datum",
     "descr": "Datum uplate.",
     "default": "Date()"
    },
    {
     "name": "nacin_placanja",
     "caption": "Način plaćanja",
     "type": "text",
     "role": "kategorija",
     "descr": "Kako je članarina plaćena.",
     "choices": "Gotovina,Uplatnica,Kartica",
     "default": "\"Uplatnica\""
    }
   ],
   "sample": [
    [
     1,
