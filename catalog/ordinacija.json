{
 "id": "ordinacija",
 "title": "Ordinacija i pacijenti",
 "descr": "Mala ordinacija: pacijenti, zakazani termini, pregledi s dijagnozom te propisani lijekovi.",
 "tags": "zdravlje,ordinacija,evidencija",
 "tables": [
  {
