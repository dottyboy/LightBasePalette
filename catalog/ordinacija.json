    {
     "name": "sifra",
     "caption": "Šifra",
     "type": "autonumber",
     "role": "kljuc",
     "descr": "Šifra pacijenta.",
     "pk": true
    },
    {
     "name": "ime",
     "caption": "Ime",
     "type": "text",
     "role": "naziv",
     "descr": "Osobno ime.",
     "required": true
    },
    {
     "name": "prezime",
     "caption": "Prezime",
     "type": "text",
     "role": "naziv",
     "descr": "Prezime.",
     "required": true
    },
    {
     "name": "oib",
     "caption": "OIB",
     "type": "text",
     "role": "identifikator",
     "descr": "Osobni identifikacijski broj, 11 znamenki (kod tvrtke ili osobe).",
     "validation": "Len([value]) = 11 And IsNumeric([value])",
     "validation_msg": "OIB mora imati točno 11 znamenki."
    },
    {
     "name": "datum_rodjenja",
     "caption": "Datum rođenja",
     "type": "date",
     "role": "datum",
     "descr": "Datum rođenja osobe."
    },
    {
     "name": "spol",
     "caption": "Spol",
     "type": "text",
     "role": "kategorija",
     "descr": "Spol.",
     "choices": "M,Ž,Drugo"
    },
    {
     "name": "mbo",
     "caption": "MBO",
     "type": "text",
     "role": "identifikator",
     "descr": "Matični broj osiguranika (9 znamenki).",
     "validation": "Len([value]) = 9 And IsNumeric([value])",
     "validation_msg": "MBO ima 9 znamenki."
    },
    {
     "name": "telefon",
     "caption": "Telefon",
     "type": "text",
     "role": "kontakt",
     "descr": "Broj telefona ili mobitela, slobodnog oblika."
    },
    {
     "name": "email",
     "caption": "E-pošta",
     "type": "text",
     "role": "kontakt",
     "descr": "Adresa elektroničke pošte; provjerava se oblik a@b.c.",
     "validation": "[value] Like \"*@*.*\"",
     "validation_msg": "Unesi ispravnu adresu e-pošte (npr. ime@tvrtka.hr).",
     "width": 200
    },
    {
     "name": "adresa",
     "caption": "Adresa",
     "type": "text",
     "role": "adresa",
     "descr": "Ulica i kućni broj.",
     "width": 200
    },
    {
     "name": "alergije",
     "caption": "Alergije",
     "type": "memo",
     "role": "biljeska",
     "descr": "Poznate alergije i nepodnošenje lijekova."
    },
    {
     "name": "aktivan",
     "caption": "Aktivan",
     "type": "yesno",
     "role": "oznaka",
     "descr": "Isključi umjesto brisanja kad se redak više ne koristi, da stara povijest ostane čitljiva.",
     "default": "True"
    }
   ],
