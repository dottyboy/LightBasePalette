{
 "id": "webshop",
 "title": "Web trgovina",
 "descr": "Mala internetska trgovina: kupci, proizvodi sa zalihom, narudžbe sa statusom isporuke i stavke narudžbe.",
 "tags": "prodaja,webshop,narudzbe",
 "tables": [
  {
   "name": "kupac_shopa",
   "caption": "Kupci",
   "descr": "Registrirani kupci trgovine.",
   "fields": [
    {
     "name": "sifra",
     "caption": "Šifra",
     "type": "autonumber",
     "role": "kljuc",
     "descr": "Šifra kupca.",
     "pk": true
    },
    {
     "name": "ime",
     "caption": "Ime",
     "type": "text",
     "role": "naziv",
     "descr": "Osobno ime.",
     "required": true
    },
    {
     "name": "prezime",
     "caption": "Prezime",
     "type": "text",
     "role": "naziv",
     "descr": "Prezime.",
     "required": true
    },
    {
     "name": "email",
     "caption": "E-pošta",
     "type": "text",
     "role": "kontakt",
     "descr": "Adresa elektroničke pošte; provjerava se oblik a@b.c.",
     "validation": "[value] Like \"*@*.*\"",
     "validation_msg": "Unesi ispravnu adresu e-pošte (npr. ime@tvrtka.hr).",
     "width": 200
    },
    {
     "name": "telefon",
     "caption": "Telefon",
     "type": "text",
     "role": "kontakt",
     "descr": "Broj telefona ili mobitela, slobodnog oblika."
    },
    {
     "name": "adresa",
     "caption": "Adresa",
     "type": "text",
     "role": "adresa",
     "descr": "Ulica i kućni broj.",
     "width": 200
    },
    {
     "name": "postanski_broj",
     "caption": "Poštanski broj",
     "type": "text",
     "role": "adresa",
     "descr": "Poštanski broj mjesta."
    },
    {
     "name": "mjesto",
     "caption": "Mjesto",
     "type": "text",
     "role": "adresa",
     "descr": "Grad ili naselje."
    },
    {
     "name": "drzava",
     "caption": "Država",
     "type": "text",
     "role": "adresa",
     "descr": "Država; zadano Hrvatska.",
     "default": "\"Hrvatska\""
    },
    {
     "name": "datum_registracije",
     "caption": "Registriran",
     "type": "date",
     "role": "datum",
     "descr": "Kada se kupac registrirao.",
     "default": "Date()"
    },
    {
     "name": "aktivan",
     "caption": "Aktivan",
     "type": "yesno",
     "role": "oznaka",
     "descr": "Isključi umjesto brisanja kad se redak više ne koristi, da stara povijest ostane čitljiva.",
     "default": "True"
    }
   ],
   "sample": [
