    {
     "name": "pdv_stopa",
     "caption": "PDV (%)",
     "type": "decimal",
     "role": "postotak",
     "descr": "Stopa PDV-a u postocima (0, 5, 13 ili 25).",
     "decimals": 0,
     "default": "25",
     "validation": "[value] In (0, 5, 13, 25)",
     "validation_msg": "Dopuštene stope PDV-a: 0, 5, 13, 25."
    },
    {
     "name": "na_zalihi",
     "caption": "Na zalihi",
     "type": "decimal",
     "role": "kolicina",
     "descr": "Količina dostupna za prodaju.",
     "decimals": 0,
     "default": "0",
     "validation": "[value] >= 0",
     "validation_msg": "Zaliha ne može biti negativna."
    },
    {
     "name": "slika",
     "caption": "Slika",
     "type": "picture",
     "role": "slika",
     "descr": "Fotografija proizvoda."
    },
    {
     "name": "aktivan",
     "caption": "Aktivan",
     "type": "yesno",
     "role": "oznaka",
     "descr": "Isključi da se proizvod ne prikazuje u trgovini.",
     "default": "True"
    }
   ],
