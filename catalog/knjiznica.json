    {
     "name": "godina_rodjenja",
     "caption": "Godina rođenja",
     "type": "integer",
     "role": "datum",
     "descr": "Godina rođenja autora.",
     "validation": "[value] >= 1000 And [value] <= 2100",
     "validation_msg": "Unesi ispravnu godinu."
