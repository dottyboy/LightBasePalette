program TyphAccess;

{$mode objfpc}{$H+}

uses
  {$IFDEF UNIX}cthreads,{$ENDIF}
  Interfaces, Forms, ta_meta, ta_locale, ta_mainform;

begin
  UseCroatianFormats;
  Application.Title := 'TyphAccess';
  Application.Scaled := True;
  Application.Initialize;
  Application.CreateForm(TMainForm, MainForm);
  Application.Run;
end.
