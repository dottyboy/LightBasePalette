unit ta_showcasedata;
{ GENERIRANO (tools/gen_showcase.py): 4GL programi, PascalScript modul i popis funkcija za primjer "Trgovina Jadran". Ne uredjuj rucno. }

{$mode objfpc}{$H+}

interface

function ShowcaseProgramCount: Integer;
function ShowcaseProgramName(AIndex: Integer): string;
function ShowcaseProgramText(AIndex: Integer): string;
function ShowcaseModuleText: string;
{ skupina|naziv|potpis|opis|primjer }
function ShowcaseFuncCount: Integer;
function ShowcaseFuncRow(AIndex: Integer): string;

implementation

function Prog0: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Mjesečni obračun prodaje' + #10;
  S := S + '-- opis: grupiranje u SQL-u, ukupno u programu (recept 9), poravnat ispis (recept 7)' + #10;
  S := S + '-- expect: 2025-01         27      9,896.38    2,330.51' + #10;
  S := S + '-- expect: Ukupno s PDV-om: 213,501.51' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE mj TEXT' + #10;
  S := S + '  DEFINE n INTEGER' + #10;
  S := S + '  DEFINE osn, pdv, ukupno DECIMAL(12,2)' + #10;
  S := S + '  DECLARE c CURSOR FOR' + #10;
  S := S + '    SELECT strftime(''%Y-%m'', r.datum), COUNT(DISTINCT r.id), ROUND(SUM(s.iznos), 2), ROUND(SUM(s.iznos * s.pdv_stopa / 100.0), 2)' + #10;
  S := S + '      FROM racuni r JOIN racuni_stavke s ON s.dokument_id = r.id' + #10;
  S := S + '     GROUP BY 1 ORDER BY 1' + #10;
  S := S + '  LET ukupno = 0' + #10;
  S := S + '  DISPLAY RPad("Mjesec", 10), LPad("Računa", 8), LPad("Osnovica", 14), LPad("PDV", 12)' + #10;
  S := S + '  FOREACH c INTO mj, n, osn, pdv' + #10;
  S := S + '    DISPLAY RPad(mj, 10), LPad(n USING "####&", 8), LPad(osn USING "###,###,##0.00", 14), LPad(pdv USING "##,##0.00", 12)' + #10;
  S := S + '    LET ukupno = ukupno + osn + pdv' + #10;
  S := S + '  END FOREACH' + #10;
  S := S + '  DISPLAY "Ukupno s PDV-om: ", ukupno USING "###,###,##0.00"' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog1: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Novi račun sa sljedećim brojem' + #10;
  S := S + '-- opis: sljedeći broj dokumenta (recept 5), vrijednosti iz programa kao $parametri' + #10;
  S := S + '-- expect: Novi račun: 2026-275' + #10;
  S := S + '-- expect-sql: SELECT COUNT(*) FROM racuni WHERE broj = ''2026-275'' => 1' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE sljedeci, godina INTEGER' + #10;
  S := S + '  DEFINE broj TEXT' + #10;
  S := S + '  DEFINE danas, dosp DATE' + #10;
  S := S + '  LET danas = DateSerial(2026, 11, 4)' + #10;
  S := S + '  LET godina = Year(danas)' + #10;
  S := S + '  LET dosp = DateAdd("d", 15, danas)' + #10;
  S := S + '  SELECT COALESCE(MAX(CAST(SUBSTR(broj, 6) AS INTEGER)), 0) + 1 INTO sljedeci FROM racuni WHERE broj LIKE $godina || ''-%''' + #10;
  S := S + '  LET broj = godina || "-" || Format(sljedeci, "000")' + #10;
  S := S + '  INSERT INTO racuni (broj, datum, dospijece, partner_id, placeno) VALUES ($broj, $danas, $dosp, 30, 0)' + #10;
  S := S + '  DISPLAY "Novi račun: ", broj' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog2: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Zatezne kamate za neplaćene račune' + #10;
  S := S + '-- opis: datumi i rokovi (recept 13), CASE (recept 19), zbroj u programu' + #10;
  S := S + '-- expect: Neplaćenih računa u kašnjenju: 34' + #10;
  S := S + '-- expect: Od toga preko 90 dana: 16' + #10;
  S := S + '-- expect: Obračunate kamate: 770.10' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE broj TEXT' + #10;
  S := S + '  DEFINE dospijece, danas DATE' + #10;
  S := S + '  DEFINE osnovica, kamata, ukupno DECIMAL(12,2)' + #10;
  S := S + '  DEFINE dani, n, kasni INTEGER' + #10;
  S := S + '  LET danas = DateSerial(2026, 11, 4)' + #10;
  S := S + '  LET ukupno = 0' + #10;
  S := S + '  LET n = 0' + #10;
  S := S + '  LET kasni = 0' + #10;
  S := S + '  DECLARE c CURSOR FOR' + #10;
  S := S + '    SELECT r.broj, r.dospijece, ROUND(SUM(s.iznos * (1 + s.pdv_stopa / 100.0)), 2)' + #10;
  S := S + '      FROM racuni r JOIN racuni_stavke s ON s.dokument_id = r.id' + #10;
  S := S + '     WHERE r.placeno = 0 AND r.dospijece < ''2026-11-04''' + #10;
  S := S + '     GROUP BY r.id ORDER BY r.dospijece' + #10;
  S := S + '  FOREACH c INTO broj, dospijece, osnovica' + #10;
  S := S + '    LET dani = DateDiff("d", dospijece, danas)' + #10;
  S := S + '    CASE' + #10;
  S := S + '      WHEN dani > 90' + #10;
  S := S + '        LET kamata = ROUND(osnovica * 0.12 * dani / 365, 2)' + #10;
  S := S + '        LET kasni = kasni + 1' + #10;
  S := S + '      WHEN dani > 30' + #10;
  S := S + '        LET kamata = ROUND(osnovica * 0.12 * dani / 365, 2)' + #10;
  S := S + '      OTHERWISE' + #10;
  S := S + '        LET kamata = 0' + #10;
  S := S + '    END CASE' + #10;
  S := S + '    LET ukupno = ukupno + kamata' + #10;
  S := S + '    LET n = n + 1' + #10;
  S := S + '  END FOREACH' + #10;
  S := S + '  DISPLAY "Neplaćenih računa u kašnjenju: ", n' + #10;
  S := S + '  DISPLAY "Od toga preko 90 dana: ", kasni' + #10;
  S := S + '  DISPLAY "Obračunate kamate: ", ukupno USING "###,##0.00"' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog3: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Pet najvećih kupaca (polje u memoriji)' + #10;
  S := S + '-- opis: polje i sortiranje u programu (recept 16), funkcija s više povratnih vrijednosti (recept 8)' + #10;
  S := S + '-- expect: 1. Posavina market d.d.                    9,111.96' + #10;
  S := S + '-- expect: 5. Kornat caffe j.d.o.o.                   4,911.87' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE naz ARRAY[200] OF TEXT' + #10;
  S := S + '  DEFINE zbr ARRAY[200] OF DECIMAL(12,2)' + #10;
  S := S + '  DEFINE ime TEXT' + #10;
  S := S + '  DEFINE iznos, t DECIMAL(12,2)' + #10;
  S := S + '  DEFINE tn TEXT' + #10;
  S := S + '  DEFINE n, i, j INTEGER' + #10;
  S := S + '  DECLARE c CURSOR FOR' + #10;
  S := S + '    SELECT p.naziv, ROUND(SUM(s.iznos), 2)' + #10;
  S := S + '      FROM racuni r JOIN partneri p ON p.id = r.partner_id JOIN racuni_stavke s ON s.dokument_id = r.id' + #10;
  S := S + '     GROUP BY p.id' + #10;
  S := S + '  LET n = 0' + #10;
  S := S + '  FOREACH c INTO ime, iznos' + #10;
  S := S + '    LET n = n + 1' + #10;
  S := S + '    LET naz[n] = ime' + #10;
  S := S + '    LET zbr[n] = iznos' + #10;
  S := S + '  END FOREACH' + #10;
  S := S + '  FOR i = 1 TO 5' + #10;
  S := S + '    FOR j = i + 1 TO n' + #10;
  S := S + '      IF zbr[j] > zbr[i] THEN' + #10;
  S := S + '        LET t = zbr[i]' + #10;
  S := S + '        LET zbr[i] = zbr[j]' + #10;
  S := S + '        LET zbr[j] = t' + #10;
  S := S + '        LET tn = naz[i]' + #10;
  S := S + '        LET naz[i] = naz[j]' + #10;
  S := S + '        LET naz[j] = tn' + #10;
  S := S + '      END IF' + #10;
  S := S + '    END FOR' + #10;
  S := S + '  END FOR' + #10;
  S := S + '  FOR i = 1 TO 5' + #10;
  S := S + '    DISPLAY i, ". ", RPad(naz[i], 36), LPad(zbr[i] USING "###,##0.00", 12)' + #10;
  S := S + '  END FOR' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog4: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Artikli ispod minimalne zalihe' + #10;
  S := S + '-- opis: uvjet u upitu, a ne u petlji (recept 18); stanje iz skladišnih dokumenata' + #10;
  S := S + '-- expect: A080 Sapun tekući 500 ml            stanje 20 / min 40' + #10;
  S := S + '-- expect: Artikala ispod minimuma: 10' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE sifra, naziv TEXT' + #10;
  S := S + '  DEFINE stanje, minimum DECIMAL(12,2)' + #10;
  S := S + '  DEFINE n INTEGER' + #10;
  S := S + '  LET n = 0' + #10;
  S := S + '  DECLARE c CURSOR FOR' + #10;
  S := S + '    SELECT a.sifra, a.naziv, a.min_zaliha,' + #10;
  S := S + '           COALESCE((SELECT SUM(CASE WHEN d.tip = ''Primka'' THEN k.kolicina ELSE -k.kolicina END)' + #10;
  S := S + '                       FROM skl_stavke k JOIN skl_dokumenti d ON d.id = k.dokument_id WHERE k.artikl_id = a.id), 0) AS stanje' + #10;
  S := S + '      FROM artikli a WHERE a.aktivan = 1' + #10;
  S := S + '     ORDER BY 4, a.naziv' + #10;
  S := S + '  FOREACH c INTO sifra, naziv, minimum, stanje' + #10;
  S := S + '    IF stanje < minimum THEN' + #10;
  S := S + '      DISPLAY sifra, " ", RPad(naziv, 30), " stanje ", stanje USING "###0", " / min ", minimum USING "###0"' + #10;
  S := S + '      LET n = n + 1' + #10;
  S := S + '    END IF' + #10;
  S := S + '  END FOREACH' + #10;
  S := S + '  DISPLAY "Artikala ispod minimuma: ", n' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog5: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Poskupljenje kategorije za postotak' + #10;
  S := S + '-- opis: unos s provjerom (recept 6), masovna izmjena i broj zahvaćenih redaka (recept 4)' + #10;
  S := S + '-- prompt: abc' + #10;
  S := S + '-- prompt: 8' + #10;
  S := S + '-- expect: Poskupjelo artikala u kategoriji Kava i čaj: 9 (8 %)' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE s TEXT' + #10;
  S := S + '  DEFINE p DECIMAL(5,2)' + #10;
  S := S + '  DEFINE n, pokusaji INTEGER' + #10;
  S := S + '  LET p = 0' + #10;
  S := S + '  LET pokusaji = 0' + #10;
  S := S + '  WHILE (p <= 0 OR p > 30) AND pokusaji < 5' + #10;
  S := S + '    LET pokusaji = pokusaji + 1' + #10;
  S := S + '    PROMPT "Za koliko posto (1-30)? " FOR s' + #10;
  S := S + '    IF IsNumeric(s) THEN' + #10;
  S := S + '      LET p = s' + #10;
  S := S + '    END IF' + #10;
  S := S + '    IF p <= 0 OR p > 30 THEN' + #10;
  S := S + '      DISPLAY "Upiši broj između 1 i 30"' + #10;
  S := S + '    END IF' + #10;
  S := S + '  END WHILE' + #10;
  S := S + '  IF p <= 0 OR p > 30 THEN' + #10;
  S := S + '    DISPLAY "Odustajem: nije upisan ispravan postotak"' + #10;
  S := S + '    RETURN' + #10;
  S := S + '  END IF' + #10;
  S := S + '  UPDATE artikli SET cijena = ROUND(cijena * (1 + $p / 100), 2) WHERE kategorija_id = 2 AND aktivan = 1' + #10;
  S := S + '  LET n = SQLCA.SQLERRD[3]' + #10;
  S := S + '  DISPLAY "Poskupjelo artikala u kategoriji Kava i čaj: ", n, " (", p, " %)"' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog6: string;
