  S := S + '-- expect-sql: SELECT COUNT(*) FROM partneri => 144' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  CALL obrisi(26)' + #10;
  S := S + '  CALL obrisi(145)' + #10;
  S := S + 'END MAIN' + #10;
  S := S + '' + #10;
  S := S + 'FUNCTION obrisi(id)' + #10;
  S := S + '  DEFINE id, n, m INTEGER' + #10;
  S := S + '  DEFINE naziv TEXT' + #10;
  S := S + '  SELECT naziv INTO naziv FROM partneri WHERE id = $id' + #10;
  S := S + '  SELECT COUNT(*) INTO n FROM racuni WHERE partner_id = $id AND placeno = 0' + #10;
  S := S + '  SELECT COUNT(*) INTO m FROM racuni WHERE partner_id = $id' + #10;
  S := S + '  IF n > 0 THEN' + #10;
  S := S + '    DISPLAY "Kupac ", naziv, " ima ", n, " neplaćenih računa, ne brišem"' + #10;
  S := S + '  ELSE' + #10;
  S := S + '    IF m > 0 THEN' + #10;
  S := S + '      DISPLAY "Kupac ", naziv, " ima račune (", m, "), ne brišem"' + #10;
