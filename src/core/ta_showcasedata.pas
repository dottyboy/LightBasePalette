function Prog9: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Računi u razdoblju iznad iznosa (PREPARE)' + #10;
  S := S + '-- opis: upit s više parametara (recept 15), prekid petlje pragom (recept 20)' + #10;
  S := S + '-- prompt: 2026-01-01' + #10;
  S := S + '-- prompt: 2026-03-31' + #10;
  S := S + '-- prompt: 300' + #10;
  S := S + '-- expect: Računa od 2026-01-01 do 2026-03-31 iznad 300: 35' + #10;
  S := S + '-- expect: Ukupno: 19,360.05' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE od, do, minimum TEXT' + #10;
  S := S + '  DEFINE n INTEGER' + #10;
  S := S + '  DEFINE suma DECIMAL(14,2)' + #10;
  S := S + '  PROMPT "Od datuma (gggg-mm-dd): " FOR od' + #10;
  S := S + '  PROMPT "Do datuma: " FOR do' + #10;
  S := S + '  PROMPT "Najmanji iznos s PDV-om: " FOR minimum' + #10;
  S := S + '  PREPARE p FROM "SELECT COUNT(*), COALESCE(SUM(t.iznos), 0) FROM (SELECT r.id, SUM(s.iznos * (1 + s.pdv_stopa / 100.0)) AS iznos FROM racuni r JOIN racuni_stavke s ON s.dokument_id = r.id WHERE r.datum BETWEEN ? AND ? GROUP BY r.id HAVING SUM(s.iznos * (1 + s.pdv_stopa / 100.0)) >= CAST(? AS REAL)) t"' + #10;
  S := S + '  DECLARE c CURSOR FOR p' + #10;
  S := S + '  OPEN c USING od, do, minimum' + #10;
  S := S + '  FETCH c INTO n, suma' + #10;
  S := S + '  CLOSE c' + #10;
  S := S + '  DISPLAY "Računa od ", od, " do ", do, " iznad ", minimum, ": ", n' + #10;
  S := S + '  DISPLAY "Ukupno: ", suma USING "###,##0.00"' + #10;
  S := S + 'END MAIN' + #10;
  Result := S;
end;

function Prog10: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Cjenik po kategorijama (REPORT)' + #10;
  S := S + '-- opis: izvješće s grupama i zbrojevima, ispis u datoteku' + #10;
  S := S + '-- expect: Cjenik je ispisan u /tmp/jadran-cjenik.txt' + #10;
  S := S + 'REPORT cjenik(r)' + #10;
  S := S + '  DEFINE r RECORD kategorija TEXT, naziv TEXT, jmj TEXT, cijena DECIMAL(10,2) END RECORD' + #10;
  S := S + '  OUTPUT PAGE LENGTH 60' + #10;
  S := S + '  ORDER BY r.kategorija, r.naziv' + #10;
  S := S + '  FORMAT' + #10;
  S := S + '    PAGE HEADER' + #10;
  S := S + '      PRINT "CJENIK  Trgovina Jadran", COLUMN 60, "Str. ", PAGENO' + #10;
  S := S + '      PRINT "------------------------------------------------------------------"' + #10;
  S := S + '    BEFORE GROUP OF r.kategorija' + #10;
  S := S + '      SKIP 1 LINES' + #10;
  S := S + '      PRINT r.kategorija' + #10;
  S := S + '    ON EVERY ROW' + #10;
  S := S + '      PRINT COLUMN 4, r.naziv, COLUMN 40, r.jmj, COLUMN 50, r.cijena USING "###&.&&"' + #10;
  S := S + '    AFTER GROUP OF r.kategorija' + #10;
  S := S + '      PRINT COLUMN 4, GROUP COUNT(*) USING "#&", " artikala"' + #10;
  S := S + '    ON LAST ROW' + #10;
  S := S + '      SKIP 1 LINES' + #10;
