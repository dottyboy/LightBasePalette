function Prog13: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Prijenos dijela uplate na drugi račun (transakcija)' + #10;
  S := S + '-- opis: obje izmjene su jedna cjelina, ili prođu ili se poništavaju (recept 3)' + #10;
  S := S + '-- expect: Preneseno 50.00' + #10;
  S := S + '-- expect: Nedovoljno na uplati, poništeno' + #10;
  S := S + '-- expect-sql: SELECT SUM(iznos) FROM uplate WHERE racun_id = 2 AND nacin = ''Prijenos'' => 50' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  CALL prenesi(1, 2, 50)' + #10;
  S := S + '  CALL prenesi(1, 2, 100000)' + #10;
  S := S + 'END MAIN' + #10;
  S := S + '' + #10;
  S := S + 'FUNCTION prenesi(od, prema, iznos)' + #10;
  S := S + '  DEFINE od, prema INTEGER' + #10;
  S := S + '  DEFINE iznos, ostalo DECIMAL(12,2)' + #10;
  S := S + '  DEFINE n INTEGER' + #10;
  S := S + '  SELECT COUNT(*) INTO n FROM uplate WHERE racun_id = $od' + #10;
  S := S + '  IF n = 0 THEN' + #10;
  S := S + '    INSERT INTO uplate (racun_id, datum, iznos, nacin) VALUES ($od, ''2026-11-01'', 200, ''Virman'')' + #10;
  S := S + '  END IF' + #10;
  S := S + '  BEGIN WORK' + #10;
  S := S + '  UPDATE uplate SET iznos = iznos - $iznos WHERE racun_id = $od' + #10;
  S := S + '  INSERT INTO uplate (racun_id, datum, iznos, nacin) VALUES ($prema, ''2026-11-04'', $iznos, ''Prijenos'')' + #10;
  S := S + '  SELECT COALESCE(MIN(iznos), 0) INTO ostalo FROM uplate WHERE racun_id = $od' + #10;
  S := S + '  IF ostalo <= 0 THEN' + #10;
  S := S + '    ROLLBACK WORK' + #10;
  S := S + '    DISPLAY "Nedovoljno na uplati, poništeno"' + #10;
  S := S + '  ELSE' + #10;
  S := S + '    COMMIT WORK' + #10;
  S := S + '    DISPLAY "Preneseno ", iznos USING "###0.00"' + #10;
  S := S + '  END IF' + #10;
  S := S + 'END FUNCTION' + #10;
  Result := S;
end;

function Prog14: string;
var
  S: string;
begin
  S := '';
  S := S + '-- naziv: Zbroj prodaje po prodavačima (FOREACH i funkcija)' + #10;
  S := S + '-- opis: funkcija s više povratnih vrijednosti (recept 8)' + #10;
  S := S + '-- expect: Lucija Vidović                 15,246.66' + #10;
  S := S + '-- expect: Najmanja stavka 1.53, najveća 1786' + #10;
  S := S + 'MAIN' + #10;
  S := S + '  DEFINE ime TEXT' + #10;
  S := S + '  DEFINE zbroj, lo, hi DECIMAL(12,2)' + #10;
  S := S + '  DECLARE c CURSOR FOR' + #10;
  S := S + '    SELECT z.ime || '' '' || z.prezime, ROUND(SUM(s.iznos), 2)' + #10;
  S := S + '      FROM racuni r JOIN zaposlenici z ON z.id = r.zaposlenik_id JOIN racuni_stavke s ON s.dokument_id = r.id' + #10;
  S := S + '     GROUP BY z.id ORDER BY 2 DESC' + #10;
  S := S + '  FOREACH c INTO ime, zbroj' + #10;
  S := S + '    DISPLAY RPad(ime, 26), LPad(zbroj USING "###,##0.00", 14)' + #10;
  S := S + '  END FOREACH' + #10;
  S := S + '  CALL raspon() RETURNING lo, hi' + #10;
  S := S + '  DISPLAY "Najmanja stavka ", lo, ", najveća ", hi' + #10;
  S := S + 'END MAIN' + #10;
  S := S + '' + #10;
  S := S + 'FUNCTION raspon()' + #10;
  S := S + '  DEFINE lo, hi DECIMAL(12,2)' + #10;
  S := S + '  SELECT MIN(iznos), MAX(iznos) INTO lo, hi FROM racuni_stavke' + #10;
  S := S + '  RETURN lo, hi' + #10;
  S := S + 'END FUNCTION' + #10;
  Result := S;
end;

function ModuleSrc: string;
var
  S: string;
begin
  S := '';
  S := S + '// Poslovne funkcije trgovine: pozivaju se iz izraza (=RazredKupca([ukupno])), 4GL-a (pas.OibIspravan(oib)) i makroa (run:ZabiljeziDnevnik).' + #10;
  S := S + '// test: Marza(1.60, 2.00) => 20' + #10;
  S := S + '// test: RabatPoKolicini(3) => 0' + #10;
  S := S + '// test: RabatPoKolicini(120) => 5' + #10;
  S := S + '// test: RazredKupca(25000) => Zlatni' + #10;
  S := S + '// test: RazredKupca(9000) => Srebrni' + #10;
  S := S + '// test: RazredKupca(100) => Redovni' + #10;
  S := S + '// test: Kamata(1000, 73) => 24' + #10;
  S := S + '// test: Zaokruzi5(1.23) => 1.25' + #10;
  S := S + '// test: OibIspravan("69435151530") => True' + #10;
  S := S + '// test: OibIspravan("69435151531") => False' + #10;
  S := S + '// test: SifraArtikla("Kava mljevena", 7) => KAV-007' + #10;
  S := S + '' + #10;
  S := S + 'function Marza(nabavna, prodajna: Double): Double;' + #10;
  S := S + 'begin' + #10;
  S := S + '  if prodajna = 0 then' + #10;
  S := S + '    Result := 0' + #10;
  S := S + '  else' + #10;
  S := S + '    Result := Round((prodajna - nabavna) / prodajna * 10000) / 100.0;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function RabatPoKolicini(kol: Double): Double;' + #10;
  S := S + 'begin' + #10;
  S := S + '  if kol >= 100 then' + #10;
  S := S + '    Result := 5' + #10;
  S := S + '  else if kol >= 50 then' + #10;
  S := S + '    Result := 3' + #10;
  S := S + '  else if kol >= 20 then' + #10;
  S := S + '    Result := 1.5' + #10;
  S := S + '  else' + #10;
  S := S + '    Result := 0;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function RazredKupca(ukupno: Double): string;' + #10;
  S := S + 'begin' + #10;
  S := S + '  if ukupno >= 20000 then' + #10;
  S := S + '    Result := ''Zlatni''' + #10;
  S := S + '  else if ukupno >= 8000 then' + #10;
  S := S + '    Result := ''Srebrni''' + #10;
  S := S + '  else if ukupno >= 2000 then' + #10;
  S := S + '    Result := ''Brončani''' + #10;
  S := S + '  else' + #10;
  S := S + '    Result := ''Redovni'';' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function Kamata(osnovica: Double; dani: Integer): Double;' + #10;
  S := S + 'begin' + #10;
  S := S + '  // zatezna kamata 12 % godišnje, jednostavna' + #10;
  S := S + '  Result := Round(osnovica * 0.12 * dani / 365 * 100) / 100.0;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function Zaokruzi5(x: Double): Double;' + #10;
  S := S + 'begin' + #10;
  S := S + '  Result := Round(x * 20 + 0.0001) / 20.0;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function OibIspravan(oib: string): Boolean;' + #10;
  S := S + 'var' + #10;
  S := S + '  i, a, d: Integer;' + #10;
  S := S + 'begin' + #10;
  S := S + '  Result := False;' + #10;
  S := S + '  if Length(oib) <> 11 then Exit;' + #10;
  S := S + '  a := 10;' + #10;
  S := S + '  for i := 1 to 10 do' + #10;
  S := S + '  begin' + #10;
  S := S + '    d := Ord(oib[i]) - 48;' + #10;
  S := S + '    if (d < 0) or (d > 9) then Exit;' + #10;
  S := S + '    a := (a + d) mod 10;' + #10;
  S := S + '    if a = 0 then a := 10;' + #10;
  S := S + '    a := (a * 2) mod 11;' + #10;
  S := S + '  end;' + #10;
  S := S + '  d := (11 - a) mod 10;' + #10;
  S := S + '  Result := (Ord(oib[11]) - 48) = d;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'function SifraArtikla(naziv: string; n: Integer): string;' + #10;
  S := S + 'var' + #10;
  S := S + '  s, t: string;' + #10;
  S := S + 'begin' + #10;
  S := S + '  s := UpperCase(Copy(naziv, 1, 3));' + #10;
  S := S + '  t := IntToStr(n);' + #10;
  S := S + '  while Length(t) < 3 do' + #10;
  S := S + '    t := ''0'' + t;' + #10;
  S := S + '  Result := s + ''-'' + t;' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'procedure ZabiljeziDnevnik(izvor, poruka: string);' + #10;
  S := S + 'begin' + #10;
  S := S + '  SqlExec(''INSERT INTO dnevnik (vrijeme, izvor, poruka) VALUES (datetime(''''now''''), '''''' + izvor + '''''', '''''' + poruka + '''''')'');' + #10;
  S := S + 'end;' + #10;
  S := S + '' + #10;
  S := S + 'procedure ZabiljeziZakljucak;' + #10;
  S := S + 'begin' + #10;
  S := S + '  ZabiljeziDnevnik(''zaključak'', ''Mjesečni obračun je pokrenut'');' + #10;
  S := S + 'end;' + #10;
  Result := S;
end;

