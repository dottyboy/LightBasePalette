  S := S + '      WHENEVER ERROR CONTINUE' + #10;
  S := S + '      DELETE FROM partneri WHERE id = $id' + #10;
  S := S + '      WHENEVER ERROR STOP' + #10;
  S := S + '      IF SQLCA.SQLCODE = 0 THEN' + #10;
  S := S + '        DISPLAY "Obrisan kupac ", naziv' + #10;
  S := S + '      ELSE' + #10;
  S := S + '        DISPLAY "Brisanje nije uspjelo"' + #10;
  S := S + '      END IF' + #10;
  S := S + '    END IF' + #10;
  S := S + '  END IF' + #10;
  S := S + 'END FUNCTION' + #10;
  Result := S;
end;

