  S := S + ''#10'</tbody>'#10'</table>'#10'<p>Zajednička svojstva: položaj i veličina <code>Left</code>,'#10'<code>Top</code>, <code>Width</code>, <code>Height</code>; izgled'#10'<code>FontNam';
