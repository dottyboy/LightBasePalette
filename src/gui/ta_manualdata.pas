  S := S + 'end</span>;</span>'#10'<span id="cb56-8"><a href="#cb56-8" aria-hidden="true" tabindex="-1"></a><span class="kw">end</span>;</span></code></pre></div>'#10'<p>(<code>txt';
  S := S + 'Id</code> je kontrola s poljem <code>id</code>.) Provjera'#10'čita <strong>spremljeno</strong> stanje iz baze, pa se ne može zaobići'#10'izmjenom kontrola. Isto stavi i';
