  S := S + '<ul>'#10'<li><strong>parametri upita</strong>: izvješće nad upitom koji u uvjetu'#10'ima <code>[?Od]</code> i <code>[?Do]</code> samo pita za vrijednosti pri'#10'otvaranju ';
