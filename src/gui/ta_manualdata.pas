  S := S + '+ PDV. Tako je ukupno uvijek jednako zbroju'#10'ispisanih stavki i PDV-a.</li>'#10'</ol>'#10'<p>Provjereno: 3 × 10,05 uz 10 % → PDV 3,02, ukupno 33,17; 130,63 uz 20'#10'% → 26,';
  S := S + '13; stavke 100,10 uz 25 % i 50,05 uz 5 % → 25,03 + 2,50 ='#10'27,53.</p>'#10'<p><strong>Zaokruživanje:</strong> za novac koristi'#10'<code>Zaokruzi(x, n)</code>: .5 uvijek ';
  S := S + 'ide na veću vrijednost (1,005 →'#10'1,01; 0,125 → 0,13). <code>Round</code> je <strong>bankarski</strong>'#10'(kao u Accessu: 0,125 → 0,12), što kod novca iznenađuje.</';
  S := S + 'p>'#10'<p><strong>Napomena o propisu:</strong> postupak je zaokruživanje PDV-a'#10'na zbroj osnovica po stopi. Je li to propisani način na računu, provjeri'#10's računovođo';
  S := S + 'm.</p>'#10'<p>Poslovni predložak <em>Dokument sa stavkama</em> već je postavljen'#10'ovako (iznos pohranjen, pravila izračuna, PDV po stopama).</p>'#10'<h2 id="zbroj-stavki';
  S := S + '-na-glavnoj-formi">Zbroj stavki na glavnoj'#10'formi</h2>'#10'<p><strong>Problem:</strong> na formi računa treba pisati ukupni zbroj'#10'stavki iz podforme.</p>'#10'<p><strong>';
  S := S + 'Rješenje:</strong> na glavnu formu stavi <code>TextBox</code>'#10's izvorom'#10'<code>=Nz(DSum(&quot;iznos&quot;, &quot;racun_stavka&quot;, &quot;racun_id = &quot; &amp';
  S := S + '; [id]), 0)</code>.'#10'Računa se iz baze, pa prati nove i izmijenjene stavke čim se spreme.'#10'Nema potrebe za referencama na podformu (u Accessu čest uzrok greške'#10'<c';
  S := S + 'ode>#Name?</code>).</p>'#10'<h2 id="broj-računa-po-godini">Broj računa po godini</h2>'#10'<p><strong>Problem:</strong> broj računa treba biti oblika'#10'<code>2026-001</cod';
  S := S + 'e>.</p>'#10'<p><strong>Rješenje:</strong> polje <code>broj</code> (tekst) dobije'#10'zadanu vrijednost izrazom'#10'<code>Format(Year(Today()), &quot;0000&quot;) &amp; &quot';
  S := S + ';-&quot; &amp; Format(Nz(DMax(&quot;id&quot;, &quot;racun&quot;, &quot;&quot;), 0) + 1, &quot;000&quot;)</code>'#10'(to koristi predložak <em>Dokument sa stavkama</';
  S := S + 'em>). Ne koristi'#10'<code>AutoNumber</code> za službeni broj: ne može se uređivati i'#10'ostavlja rupe kad se redak obriše. Ni ova zadana vrijednost ne jamči'#10'broj bez ';
  S := S + 'rupa: ako se zadnji redak obriše, njegov se broj ponovo'#10'dodjeljuje samo dok ne stigne novi, a brojač se ne vraća na 1 s novom'#10'godinom.</p>'#10'<p><strong>Napomena:<';
  S := S + '/strong> zadana vrijednost broji po ključu'#10'(<code>id</code>), ne po godini. Za brojanje koje se vraća na 1 svake'#10'godine, <code>DMax</code> treba ograničiti uvje';
  S := S + 'tom na godinu (npr. broj'#10'počinje s <code>2026-</code>) i čitati zadnji broj te godine; ako se'#10'više korisnika istodobno unosi, provjeri jedinstvenost (ograničenj';
  S := S + 'e'#10'<code>UNIQUE</code> na polju <code>broj</code>).</p>'#10'<h2 id="stanje-zalihe">Stanje zalihe</h2>'#10'<p><strong>Problem:</strong> treba znati koliko artikla ima na ';
  S := S + 'stanju'#10'kad se roba prima i izdaje.</p>'#10'<p><strong>Rješenje:</strong> nemoj umanjivati polje „količina” pri'#10'svakom izdavanju. Evidentiraj <strong>kretanja</stron';
  S := S + 'g> (primka plus,'#10'izdatnica minus) i stanje <strong>izračunaj</strong> iz njih: poslovni'#10'predložak <em>Skladišni promet</em> ovo već radi i ima upit'#10'<code>Stanje';
  S := S + ' zaliha</code>:</p>'#10'<pre><code>COALESCE(SUM(CASE WHEN d.tip = &#39;Primka&#39; THEN s.kolicina ELSE -s.kolicina END), 0) AS stanje</code></pre>'#10'<p>Primjer (prov';
  S := S + 'jereno): primka 500 i izdatnica 200 istog artikla daju'#10'stanje <strong>300</strong>.</p>'#10'<p><strong>Zašto ne polje koje se umanjuje:</strong> kad se kasnije'#10'ispr';
  S := S + 'avi količina na stavci, spremljeno stanje ostaje krivo; izračunato'#10'stanje se uvijek poklapa s dokumentima.</p>'#10'<h2 id="ovisni-kaskadni-popisi">Ovisni (kaskadni)';
  S := S + ' popisi</h2>'#10'<p><strong>Problem:</strong> popis gradova treba pokazivati samo gradove'#10'odabrane županije.</p>'#10'<p><strong>Rješenje:</strong> na formi stavi dva pa';
  S := S + 'dajuća popisa. Prvom'#10'(<code>cmbZup</code>, polje <code>zupanija_id</code>) je'#10'<code>RowSource</code>'#10'<code>SELECT id, naziv FROM zupanija ORDER BY naziv</code>.';
  S := S + ' Drugom'#10'(<code>cmbGrad</code>, polje <code>grad_id</code>) je'#10'<code>RowSource</code> s <strong>imenom prvog popisa u uglatim'#10'zagradama</strong>:</p>'#10'<pre><code>';
  S := S + 'SELECT id, naziv FROM grad WHERE zupanija_id = [cmbZup] ORDER BY naziv</code></pre>'#10'<p>Čim se promijeni prvi popis, drugi se sam osvježi (provjereno:'#10'županija 1';
  S := S + ' nudi dva grada, nakon odabira druge nudi tri njena grada). U'#10'uglatim zagradama može stajati i naziv polja forme.</p>'#10'<h2 id="zaključavanje-knjiženog-dokumenta"';
  S := S + '>Zaključavanje knjiženog'#10'dokumenta</h2>'#10'<p><strong>Problem:</strong> račun koji je knjižen ne smije se više'#10'mijenjati.</p>'#10'<p><strong>Rješenje:</strong> u tabli';
  S := S + 'ci <code>racun</code> neka postoji'#10'polje <code>knjizen</code> (Da/Ne). U modulu napiši proceduru i spoji je'#10'na događaj forme <code>BeforeUpdate</code>:</p>'#10'<div';
  S := S + ' class="sourceCode" id="cb56"><pre class="sourceCode pascal"><code class="sourceCode pascal"><span id="cb56-1"><a href="#cb56-1" aria-hidden="true" tabindex="-1';
