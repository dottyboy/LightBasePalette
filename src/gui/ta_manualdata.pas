  S := S + '/code>)</td>'#10'</tr>'#10'<tr class="even">'#10'<td><code>rednidok</code></td>'#10'<td>zadnji dodijeljeni redni broj</td>'#10'</tr>'#10'<tr class="odd">'#10'<td><code>godina</code></td>'#10'<';
  S := S + 'td>godina zadnjeg broja: svake godine brojanje počinje iznova</td>'#10'</tr>'#10'<tr class="even">'#10'<td><code>format</code></td>'#10'<td>oblik broja: <code>{sifra}</code> pr';
