  S := S + 'nGSum([iznos])</code>.</p>'#10'<h2 id="zbroj-samo-plaćenih-uvjetni-zbroj">Zbroj samo plaćenih (uvjetni'#10'zbroj)</h2>'#10'<p><strong>Problem:</strong> zbrojiti samo neke r';
