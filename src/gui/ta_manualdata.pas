  S := S + 'figcaption aria-hidden="true">Podaci o tvrtki</figcaption>'#10'</figure>'#10'<p><em>Aplikacija → Podaci o tvrtki…</em> sprema naziv, adresu,'#10'poštanski broj i mjesto, OI';
  S := S + 'B, IBAN, e-mail i telefon. Predlošci i'#10'uplatnice ih čitaju kao postavke (<code>firma.naziv</code>,'#10'<code>firma.adresa</code>, <code>firma.mjesto</code>,'#10'<code>f';
  S := S + 'irma.iban</code>…) funkcijom'#10'<code>Postavka(&quot;firma.naziv&quot;)</code>, pa se podaci unose samo'#10'jednom.</p>'#10'<h1 id="gl-programiranje-poslovnih-aplikacija">';
  S := S + '4GL: programiranje'#10'poslovnih aplikacija</h1>'#10'<p><strong>4GL</strong> je programski jezik u duhu Informix-4GL-a'#10'ugrađen u TyphAccess. Namijenjen je poslovima koj';
  S := S + 'e je teško složiti iz'#10'formi i makroa: izbornici, unos s provjerama, petlje preko rezultata'#10'upita, transakcije, tekstualna izvješća. SQL je dio jezika, bez poseb';
  S := S + 'nih'#10'biblioteka.</p>'#10'<p>Programi su obične tekstualne datoteke (<code>.4gl</code>) koje se'#10'uređuju bilo kojim uređivačem, drže u gitu i pokreću ovako:</p>'#10'<pre><';
  S := S + 'code>typhaccess --check=program.4gl                  # provjeri bez izvođenja'#10'typhaccess --run=program.4gl baza.db            # pokreni s prozorima'#10'typhaccess -';
  S := S + '-run=program.4gl baza.db --console  # pokreni u terminalu (npr. iz skripte)'#10'typhaccess --run=program.4gl --pg=host:5432/baza/korisnik</code></pre>'#10'<p>Primjeri u';
  S := S + ' ovom poglavlju koriste bazu <em>Northwind</em>'#10'(<code>typhaccess --make-northwind Northwind.db</code>). Svi cjeloviti'#10'programi ispod prolaze <code>--check</cod';
  S := S + 'e> u testovima programa.</p>'#10'<h2 id="uređivač-blokova-za-4gl">Uređivač blokova za 4GL</h2>'#10'<p><em>Skripta → 4GL program (blokovi)…</em> otvara uređivač u kojem ';
  S := S + 'se'#10'4GL program slaže blokovima, a gumb <strong>Tekst</strong> ga prebacuje'#10'u običan tekst (i natrag). Svaki redak programa je jedan blok; strukture'#10'(<code>MAIN<';
  S := S + '/code>, <code>FUNCTION</code>, <code>IF</code>,'#10'<code>WHILE</code>, <code>FOR</code>, <code>FOREACH</code>,'#10'<code>CASE</code>, <code>MENU</code>, <code>INPUT</c';
  S := S + 'ode>,'#10'<code>REPORT</code>…) su uvučene, a <code>ELSE</code>,'#10'<code>WHEN</code>, <code>COMMAND</code> stoje u razini svog početka.'#10'Redak koji ne diraš ostaje toč';
  S := S + 'no onakav kakav je bio.</p>'#10'<ul>'#10'<li><strong>Lijevo</strong> je popis predložaka po namjeni:'#10'<em>Program</em> (MAIN, funkcija, varijable), <em>Tijek</em> (IF, E';
  S := S + 'LSE,'#10'CASE, WHILE, FOR, LET, CALL, EXIT, RETURN), <em>Baza</em> (SELECT INTO,'#10'kursor s FOREACH, INSERT, UPDATE, DELETE, transakcija), <em>Ispis i'#10'unos</em> (DISP';
  S := S + 'LAY, MESSAGE, ERROR, PROMPT, MENU), <em>Ostalo</em>'#10'(komentar, WHENEVER ERROR, poziv PascalScript modula). Dvoklik umeće'#10'predložak <strong>iza označenog retka</';
  S := S + 'strong>: unutar bloka ako je'#10'označen početak bloka, inače u istoj razini.</li>'#10'<li><strong>Desno</strong> je program: tekst retka se uređuje izravno,'#10'<strong>↑ ';
  S := S + '↓</strong> ga pomiču, <strong>✕</strong> briše; brisanje'#10'početka strukture briše i njezin <code>END</code>, a sadržaj'#10'ostaje.</li>'#10'<li><strong>Provjeri</strong>';
  S := S + ' pokreće pravi parser (iste poruke kao'#10'<code>--check</code>), uz javljanje neuparenih struktura;'#10'<strong>Pokreni</strong> provjerava i izvodi program;'#10'<strong>S';
  S := S + 'premi</strong> piše <code>.4gl</code> datoteku.</li>'#10'</ul>'#10'<p>Svi predlošci su ispravan 4GL (provjereni parserom), a model je'#10'isproban na svim programima iz ovo';
  S := S + 'g priručnika i primjera.</p>'#10'<h2 id="prvi-program">1. Prvi program</h2>'#10'<pre class="4gl"><code>MAIN'#10'  DEFINE i INTEGER'#10'  DEFINE ime TEXT'#10'  LET ime = &quot;svije';
  S := S + 'te&quot;'#10'  DISPLAY &quot;Pozdrav, &quot;, ime, &quot;!&quot;'#10'  FOR i = 1 TO 3'#10'    DISPLAY &quot;Redak &quot;, i'#10'  END FOR'#10'END MAIN</code></pre>'#10'<ul>'#10'<li>Program';
  S := S + ' počinje blokom <code>MAIN</code>.</li>'#10'<li><code>DEFINE</code> deklarira varijable; <code>LET</code> im'#10'dodjeljuje vrijednost.</li>'#10'<li><code>DISPLAY</code> is';
  S := S + 'pisuje; popis se spaja bez razmaka, pa'#10'razmake pišeš sam.</li>'#10'<li>Naredbe ne trebaju točku sa zarezom; kraj retka je dovoljan.</li>'#10'<li>Komentar počinje s <cod';
  S := S + 'e>--</code> ili je u vitičastim zagradama'#10'<code>{ ... }</code>.</li>'#10'<li>Velika i mala slova se ne razlikuju.</li>'#10'</ul>'#10'<p>Tipovi: <code>INTEGER</code>, <code>';
  S := S + 'DECIMAL(10,2)</code>,'#10'<code>FLOAT</code>, <code>TEXT</code> (ili <code>CHAR</code>,'#10'<code>VARCHAR</code>), <code>DATE</code>, <code>DATETIME</code>,'#10'<code>BOOLE';
  S := S + 'AN</code>, <code>RECORD</code>, <code>ARRAY</code>.'#10'Vrijednost <code>NULL</code> znači „nema vrijednosti”;'#10'<code>IF x IS NULL THEN</code>.</p>'#10'<h2 id="naredbe-t';
  S := S + 'oka">2. Naredbe toka</h2>'#10'<pre class="4gl"><code>MAIN'#10'  DEFINE n, zbroj INTEGER'#10'  LET zbroj = 0'#10'  FOR n = 1 TO 10'#10'    IF n MOD 2 = 0 THEN'#10'      LET zbroj = zbro';
  S := S + 'j + n'#10'    END IF'#10'  END FOR'#10'  WHILE zbroj &gt; 20'#10'    LET zbroj = zbroj - 10'#10'  END WHILE'#10'  CASE zbroj'#10'    WHEN 0     DISPLAY &quot;nula&quot;'#10'    WHEN 10    DISP';
  S := S + 'LAY &quot;deset&quot;'#10'    OTHERWISE  DISPLAY &quot;ostalo: &quot;, zbroj'#10'  END CASE'#10'END MAIN</code></pre>'#10'<p>Petlje prekidaš s <code>EXIT FOR</code>, <code>EXIT';
  S := S + ' WHILE</code>,'#10'<code>EXIT FOREACH</code> ili preskačeš s <code>CONTINUE …</code>;'#10'program završava s <code>EXIT PROGRAM</code>.</p>'#10'<h2 id="baza-u-programu">3. ';
  S := S + 'Baza u programu</h2>'#10'<p>Tablica kao tip: <code>RECORD LIKE customers.*</code> uzima stupce'#10'izravno iz baze. Parametri u SQL-u pišu se kao <code>$varijabla</code';
  S := S + '>'#10'(uvijek parametar, nikad spajanje teksta, pa nema SQL injekcije).</p>'#10'<pre class="4gl"><code>DATABASE northwind'#10''#10'MAIN'#10'  DEFINE k RECORD LIKE customers.*'#10'  DEF';
  S := S + 'INE n INTEGER'#10'  SELECT COUNT(*) INTO n FROM customers'#10'  DISPLAY &quot;Kupaca: &quot;, n'#10''#10'  SELECT * INTO k.* FROM customers WHERE customerid = 1'#10'  IF SQLCA.SQLC';
  S := S + 'ODE = 100 THEN'#10'    DISPLAY &quot;Nema takvog kupca&quot;'#10'  ELSE'#10'    DISPLAY k.companyname, &quot; (&quot;, k.city, &quot;)&quot;'#10'  END IF'#10''#10'  UPDATE customers SE';
  S := S + 'T city = $k.city WHERE customerid = $k.customerid'#10'  DISPLAY &quot;Promijenjeno redaka: &quot;, SQLCA.SQLERRD[3]'#10'END MAIN</code></pre>'#10'<ul>'#10'<li><code>SELECT … IN';
  S := S + 'TO</code> puni varijable; ako nema retka,'#10'<code>SQLCA.SQLCODE</code> je 100.</li>'#10'<li><code>SQLCA.SQLERRD[3]</code> je broj redaka koje je zahvatila'#10'zadnja nare';
  S := S + 'dba.</li>'#10'<li>Pogreška SQL-a zaustavlja program porukom'#10'(<code>WHENEVER ERROR STOP</code>, zadano). Uz'#10'<code>WHENEVER ERROR CONTINUE</code> program nastavlja, a';
  S := S + ''#10'<code>SQLCA.SQLCODE</code> je negativan i tekst pogreške je u'#10'<code>SQLCA.SQLERRM</code>.</li>'#10'<li><code>BEGIN WORK</code>, <code>COMMIT WORK</code>,'#10'<code>ROL';
  S := S + 'LBACK WORK</code> upravljaju transakcijom.</li>'#10'</ul>'#10'<h3 id="kursori-petlja-preko-rezultata">Kursori: petlja preko'#10'rezultata</h3>'#10'<pre class="4gl"><code>DATABA';
  S := S + 'SE northwind'#10''#10'MAIN'#10'  DEFINE r RECORD LIKE orders.*'#10'  DEFINE kupac, n INTEGER'#10'  LET kupac = 1'#10'  DECLARE c CURSOR FOR'#10'    SELECT * FROM orders WHERE customerid = ';
  S := S + '$kupac ORDER BY orderid'#10'  LET n = 0'#10'  FOREACH c INTO r.*'#10'    LET n = n + 1'#10'    DISPLAY n, &quot;. narudžba &quot;, r.orderid'#10'    IF n &gt;= 5 THEN'#10'      EXIT FO';
  S := S + 'REACH'#10'    END IF'#10'  END FOREACH'#10'END MAIN</code></pre>'#10'<p>SQL naredba završava s krajem retka kad sljedeći redak počinje'#10'naredbom jezika (<code>LET</code>, <code>';
  S := S + 'IF</code>, <code>END</code>…);'#10'kod dugih naredbi u više redaka slobodno lomi retke. Ako SQL treba'#10'završiti usred retka, upiši <code>;</code>.</p>'#10'<p>Dinamički S';
  S := S + 'QL:'#10'<code>PREPARE p FROM &quot;SELECT … WHERE id &gt; ?&quot;</code>, pa'#10'<code>DECLARE c CURSOR FOR p</code> i <code>OPEN c USING 70</code>;'#10'<code>FETCH c INTO ';
  S := S + 'x</code> čita redak po redak, <code>CLOSE c</code>'#10'zatvara.</p>'#10'<h2 id="izbornik">4. Izbornik</h2>'#10'<pre class="4gl"><code>DATABASE northwind'#10''#10'MAIN'#10'  MENU &quot;';
  S := S + 'Northwind&quot;'#10'    COMMAND &quot;Kupci&quot;  &quot;Pregled kupaca&quot;'#10'      CALL kupci()'#10'    COMMAND &quot;Izlaz&quot;  &quot;Kraj programa&quot;'#10'      EXIT';
  S := S + ' MENU'#10'  END MENU'#10'END MAIN'#10''#10'FUNCTION kupci()'#10'  DEFINE r RECORD LIKE customers.*'#10'  DECLARE c CURSOR FOR SELECT * FROM customers ORDER BY companyname'#10'  FOREACH c I';
  S := S + 'NTO r.*'#10'    DISPLAY r.customerid, &quot;  &quot;, r.companyname'#10'  END FOREACH'#10'END FUNCTION</code></pre>'#10'<p>U prozoru je izbornik niz gumba (Esc zatvara), u konz';
  S := S + 'oli numerirani'#10'popis. Svaka <code>COMMAND</code> ima naziv, kratak opis i naredbe koje'#10'se izvode.</p>'#10'<h2 id="funkcije-i-više-datoteka">5. Funkcije i više datot';
  S := S + 'eka</h2>'#10'<pre class="4gl"><code>FUNCTION zbroji(a, b)'#10'  DEFINE a, b INTEGER'#10'  RETURN a + b, a * b'#10'END FUNCTION'#10''#10'MAIN'#10'  DEFINE s, p INTEGER'#10'  CALL zbroji(3, 4) R';
  S := S + 'ETURNING s, p'#10'  DISPLAY s, &quot; &quot;, p'#10'  DISPLAY zbroji(1, 2)'#10'END MAIN</code></pre>'#10'<ul>'#10'<li>Parametri se navode imenom; tip im daješ s <code>DEFINE</code>';
  S := S + ' u'#10'tijelu funkcije.</li>'#10'<li><code>RETURN a, b</code> vraća više vrijednosti,'#10'<code>CALL … RETURNING x, y</code> ih prima.</li>'#10'<li>Funkcija se u izrazu koristi';
  S := S + ' kao <code>zbroji(1, 2)</code> (prva'#10'vraćena vrijednost).</li>'#10'<li><code>GLOBALS … END GLOBALS</code> deklarira globalne varijable,'#10'<code>INCLUDE &quot;druga.4g';
  S := S + 'l&quot;</code> uključuje drugu datoteku.</li>'#10'<li>Ugrađene funkcije: <code>Length</code>, <code>Upper</code>,'#10'<code>Lower</code>, <code>Trim</code>, <code>Subst';
  S := S + 'r</code>,'#10'<code>Nvl</code>, <code>Ask</code>, <code>LPad</code>,'#10'<code>RPad</code>, <code>Center</code>, <code>Today</code>,'#10'<code>Current</code>, te sve funkci';
  S := S + 'je izraza iz <em>Reference'#10'izraza</em> (<code>Round</code>, <code>Format</code>,'#10'<code>DateAdd</code>…). Funkcije iz modula (PascalScript) zovu se s'#10'<code>pas.N';
  S := S + 'aziv(…)</code>.</li>'#10'</ul>'#10'<h2 id="unos-podataka-1">6. Unos podataka</h2>'#10'<h3 id="jednostavan-unos">Jednostavan unos</h3>'#10'<p><code>PROMPT</code> pita jednu vrij';
  S := S + 'ednost i postavlja'#10'<code>INT_FLAG</code> na istinu ako korisnik odustane:</p>'#10'<pre class="4gl"><code>MAIN'#10'  DEFINE postotak DECIMAL(5,2)'#10'  PROMPT &quot;Postotak';
  S := S + ' poskupljenja: &quot; FOR postotak'#10'  IF NOT INT_FLAG THEN'#10'    DISPLAY &quot;Upisano: &quot;, postotak'#10'  END IF'#10'END MAIN</code></pre>'#10'<h3 id="zaslon-screen">Zasl';
  S := S + 'on (SCREEN)</h3>'#10'<p><code>SCREEN</code> opisuje polja unosa: oznaku, pravila i izbornik'#10'vrijednosti. Veže se na zapis imenima polja.</p>'#10'<pre class="4gl"><code>';
  S := S + 'DATABASE northwind'#10''#10'SCREEN s_dostavljac'#10'  TITLE &quot;Dostavljač&quot;'#10'  LABEL &quot;Šifra&quot;   FIELD shipperid   READONLY'#10'  LABEL &quot;Naziv&quot;   FIELD ';
  S := S + 'companyname REQUIRED UPSHIFT COMMENT &quot;Ime tvrtke&quot;'#10'  LABEL &quot;Telefon&quot; FIELD phone       DEFAULT &quot;000&quot;'#10'END SCREEN'#10''#10'MAIN'#10'  DEFINE k RE';
  S := S + 'CORD LIKE shippers.*'#10'  LET k.shipperid = 88'#10'  INPUT BY NAME k.* FROM s_dostavljac'#10'    AFTER FIELD companyname'#10'      IF LENGTH(k.companyname) &lt; 3 THEN'#10'       ';
  S := S + ' ERROR &quot;Naziv je prekratak&quot;'#10'        NEXT FIELD companyname'#10'      END IF'#10'  END INPUT'#10'  IF NOT INT_FLAG THEN'#10'    INSERT INTO shippers (shipperid, compan';
  S := S + 'yname, phone)'#10'      VALUES ($k.shipperid, $k.companyname, $k.phone)'#10'    DISPLAY &quot;Spremljeno: &quot;, k.companyname'#10'  END IF'#10'END MAIN</code></pre>'#10'<p>Opcije';
  S := S + ' polja: <code>READONLY</code>, <code>REQUIRED</code> (ne'#10'dopušta prazno), <code>UPSHIFT</code> (velika slova),'#10'<code>DEFAULT izraz</code>, <code>COMMENT &quot;s';
  S := S + 'avjet&quot;</code>,'#10'<code>LOOKUP tablica(ključ, naziv)</code> (padajući popis; u varijablu'#10'ide ključ). Bez <code>FROM zaslon</code> <code>INPUT BY NAME</code> s';
  S := S + 'am'#10'složi polja iz zapisa.</p>'#10'<p>Blokovi uz <code>INPUT</code>: <code>BEFORE INPUT</code>,'#10'<code>BEFORE FIELD x</code>, <code>AFTER FIELD x</code>,'#10'<code>AFTER ';
  S := S + 'INPUT</code>; <code>NEXT FIELD x</code> vraća korisnika na'#10'polje. <code>DISPLAY BY NAME zapis.* TO zaslon</code> samo prikazuje'#10'zapis.</p>'#10'<h3 id="upit-po-primj';
  S := S + 'eru-construct">Upit po primjeru (CONSTRUCT)</h3>'#10'<p>Korisnik upiše uvjete poput <code>A*</code> (počinje s A),'#10'<code>&gt;5</code>, <code>3:7</code> (od 3 do 7),';
  S := S + ' <code>a|b</code> (a'#10'ili b); program ih pretvara u <code>WHERE</code>:</p>'#10'<pre class="4gl"><code>DATABASE northwind'#10''#10'MAIN'#10'  DEFINE uvjet, sql TEXT'#10'  DEFINE n I';
  S := S + 'NTEGER'#10'  CONSTRUCT BY NAME uvjet ON customers.companyname, customers.city'#10'  IF NOT INT_FLAG THEN'#10'    LET sql = &quot;SELECT COUNT(*) FROM customers WHERE &quot;';
  S := S + ' || uvjet'#10'    PREPARE p FROM sql'#10'    DECLARE c CURSOR FOR p'#10'    OPEN c'#10'    FETCH c INTO n'#10'    CLOSE c'#10'    DISPLAY &quot;Pronađeno: &quot;, n'#10'  END IF'#10'END MAIN</';
  S := S + 'code></pre>'#10'<h2 id="mreže-polja-zapisa">7. Mreže (polja zapisa)</h2>'#10'<p><code>DISPLAY ARRAY</code> i <code>INPUT ARRAY</code> prikazuju i'#10'uređuju polje zapisa u';
  S := S + ' mreži. <code>ARRAY[]</code> je polje koje raste;'#10'<code>ARRAY[100]</code> ima najviše 100 redaka. Poslije naredbe'#10'<code>ARR_COUNT</code> je broj redaka.</p>'#10'<pr';
  S := S + 'e class="4gl"><code>DATABASE northwind'#10''#10'SCREEN s_cijene'#10'  TITLE &quot;Cjenik&quot;'#10'  LABEL &quot;Šifra&quot;    FIELD productid'#10'  LABEL &quot;Proizvod&quot; FIE';
  S := S + 'LD productname'#10'  LABEL &quot;Cijena&quot;   FIELD unitprice'#10'END SCREEN'#10''#10'MAIN'#10'  DEFINE r RECORD LIKE products.*'#10'  DEFINE lista ARRAY[] OF RECORD LIKE products.*'#10'';
  S := S + '  DEFINE n, i INTEGER'#10'  DECLARE c CURSOR FOR SELECT * FROM products WHERE categoryid = 1 ORDER BY productname'#10'  LET n = 0'#10'  FOREACH c INTO r.*'#10'    LET n = n + 1';
  S := S + ''#10'    LET lista[n].* = r.*'#10'  END FOREACH'#10''#10'  INPUT ARRAY lista FROM s_cijene'#10'  IF NOT INT_FLAG THEN'#10'    BEGIN WORK'#10'    FOR i = 1 TO ARR_COUNT'#10'      LET r.* = list';
  S := S + 'a[i].*'#10'      UPDATE products SET unitprice = $r.unitprice WHERE productid = $r.productid'#10'    END FOR'#10'    COMMIT WORK'#10'    DISPLAY &quot;Spremljeno redaka: &quot;';
  S := S + ', ARR_COUNT'#10'  END IF'#10'END MAIN</code></pre>'#10'<h2 id="otvaranje-postojećih-formi">8. Otvaranje postojećih formi</h2>'#10'<p>Uz zaslone možeš otvoriti forme izrađene u ';
  S := S + 'dizajneru:</p>'#10'<pre class="4gl"><code>DATABASE northwind'#10''#10'MAIN'#10'  OPEN FORM f_kupci FROM &quot;Customers&quot;'#10'  DISPLAY FORM f_kupci WHERE &quot;country = &#39;';
  S := S + 'Germany&#39;&quot;'#10'END MAIN</code></pre>'#10'<h2 id="izvješća-1">9. Izvješća</h2>'#10'<p>Izvješće se piše kao <code>REPORT</code> blok, a puni se naredbom'#10'<code>OUTPUT ';
  S := S + 'TO REPORT</code> redak po redak:</p>'#10'<pre class="4gl"><code>DATABASE northwind'#10''#10'REPORT cjenik(r)'#10'  DEFINE r RECORD kategorija TEXT, proizvod TEXT, cijena DECIMA';
  S := S + 'L(10,2) END RECORD'#10'  OUTPUT PAGE LENGTH 40'#10'  ORDER BY r.kategorija, r.proizvod'#10'  FORMAT'#10'    PAGE HEADER'#10'      PRINT &quot;CJENIK&quot;, COLUMN 50, &quot;Str. &q';
  S := S + 'uot;, PAGENO'#10'      PRINT &quot;----------------------------------------------------&quot;'#10'    BEFORE GROUP OF r.kategorija'#10'      SKIP 1 LINES'#10'      PRINT r.kate';
  S := S + 'gorija'#10'    ON EVERY ROW'#10'      PRINT COLUMN 4, r.proizvod, COLUMN 40, r.cijena USING &quot;####&amp;.&amp;&amp;&quot;'#10'    AFTER GROUP OF r.kategorija'#10'      PRINT';
  S := S + ' COLUMN 4, GROUP COUNT(*), &quot; proizvoda&quot;,'#10'        COLUMN 40, GROUP SUM(r.cijena) USING &quot;####&amp;.&amp;&amp;&quot;'#10'    ON LAST ROW'#10'      SKIP 1 LI';
  S := S + 'NES'#10'      PRINT &quot;UKUPNO: &quot;, SUM(r.cijena) USING &quot;#####&amp;.&amp;&amp;&quot;'#10'    PAGE TRAILER'#10'      PRINT COLUMN 50, &quot;Northwind&quot;'#10'END RE';
  S := S + 'PORT'#10''#10'MAIN'#10'  DEFINE r RECORD kategorija TEXT, proizvod TEXT, cijena DECIMAL(10,2) END RECORD'#10'  DECLARE c CURSOR FOR'#10'    SELECT c.categoryname, p.productname, p.';
