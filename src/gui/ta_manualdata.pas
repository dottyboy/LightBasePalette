  S := S + 'a, margine i'#10'naljepnice</h3>'#10'<p>Gumb <strong>Stranica i naljepnice…</strong> (druga traka dizajnera'#10'izvješća) postavlja, u milimetrima:</p>'#10'<ul>'#10'<li><strong>Pap';
