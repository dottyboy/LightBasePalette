  S := S + 'e>dokumenti</code></strong> (po jedan redak za'#10'svaku vrstu; uređuje se u <em>Aplikacija → Vrste dokumenata…</em>):</p>'#10'<table>'#10'<colgroup>'#10'<col style="width: 50%';
  S := S + '" />'#10'<col style="width: 50%" />'#10'</colgroup>'#10'<thead>'#10'<tr class="header">'#10'<th>Stupac</th>'#10'<th>Značenje</th>'#10'</tr>'#10'</thead>'#10'<tbody>'#10'<tr class="odd">'#10'<td><code>vrst';
