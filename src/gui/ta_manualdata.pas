  S := S + 'span>'#10'<span id="cb56-4"><a href="#cb56-4" aria-hidden="true" tabindex="-1"></a>  <span class="kw">begin</span></span>'#10'<span id="cb56-5"><a href="#cb56-5" aria-h';
  S := S + 'idden="true" tabindex="-1"></a>    ShowMessage(<span class="st">&#39;Račun je knjižen i ne može se mijenjati.&#39;</span>);</span>'#10'<span id="cb56-6"><a href="#c';
