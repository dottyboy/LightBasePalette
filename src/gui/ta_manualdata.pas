  S := S + ' uračuna)</td>'#10'</tr>'#10'</tbody>'#10'</table>'#10'<p>Iznos stavke je <strong>mjerodavan</strong>: sprema se u bazu i'#10'ispisuje se na računu, a cijena je izvedena iz njega. ';
  S := S + 'Pravilo koje samo'#10'upiše vrijednost ne okida druga pravila, pa nema petlje.</p>'#10'<h2 id="ukupni-iznosi-koji-štimaju-zaokruživanje-i-pdv">Ukupni iznosi'#10'koji štimaj';
  S := S + 'u: zaokruživanje i PDV</h2>'#10'<p><strong>Problem:</strong> zbroj stavki i PDV na ekranu ne odgovaraju'#10'ispisanom računu za 0,01–0,03.</p>'#10'<p><strong>Uzrok:</strong';
  S := S + '> PDV zaokružen po svakoj stavci pa zbrojen'#10'daje drugi rezultat od PDV-a na zbroj osnovica. Primjer: tri stavke po'#10'10,05 uz PDV 10 % — po stavci 3 × 1,01 = <str';
