  S := S + '-run=program.4gl baza.db --console</code>.</p>'#10'<h2 id="zbroj-i-brojanje-petljom">1. Zbroj i brojanje petljom</h2>'#10'<pre class="4gl"><code>-- expect: Ukupno: 275.';
